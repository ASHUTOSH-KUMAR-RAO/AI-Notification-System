PORT=5000
NODE_ENV=development
# Supabase pooled connection (Transaction pooler, port 6543) - used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Supabase direct connection (port 5432) - used by Prisma migrations
DIRECT_URL="postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres"
# Allowed CORS origin(s), comma-separated
CLIENT_URL=http://localhost:5173

# JWT signing secrets - each at least 32 chars and different. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# Max DB connections in the app pool (keep within your Supabase pooler limit)
DB_POOL_MAX=5

# --- AI (Groq) - optional. Without a key the app still works using a rule-based classifier. ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_SMART=openai/gpt-oss-120b
AI_TIMEOUT_MS=4000
AI_USER_LIMIT_PER_MIN=20

# --- Smart features (optional) ---
# Email (Resend): create a key at https://resend.com/api-keys. Until you verify a domain, EMAIL_FROM must stay the resend.dev sender
# and Resend only delivers to your own account email.
RESEND_API_KEY=
EMAIL_FROM=Notify <onboarding@resend.dev>
# Web push: generate a pair with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Public base URL of this API (used in email unsubscribe links), e.g. https://your-app.up.railway.app
PUBLIC_API_URL=http://localhost:5000
# Hops of trusted proxies in front of the app: 1 behind Railway, 2 when also behind a Vercel /api rewrite
TRUST_PROXY=1
# lax when the web app proxies /api/* (Vercel rewrite); none only if browsers call this API cross-site
COOKIE_SAMESITE=lax
# Set to false to disable scheduled jobs (digest, quiet-hours release, retries) on this instance
SCHEDULER_ENABLED=true
